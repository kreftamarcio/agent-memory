{
  "name": "@q1-digital/agent-memory",
  "version": "0.1.0",
  "description": "Long-term memory for AI agents: episodic, semantic, and procedural stores with temporal decay, importance scoring, and consolidation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src/ --ext .ts",
    "format": "prettier --write 'src/**/*.ts'",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai-agents",
    "agent-memory",
    "episodic-memory",
    "semantic-memory",
    "temporal-decay",
    "memory-consolidation",
    "vector-search",
    "llm",
    "typescript"
  ],
  "author": "Marcio Krefta <q1digitalfreela@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@qdrant/js-client-rest": "^1.9.0",
    "openai": "^4.52.0",
    "zod": "^3.23.0",
    "pino": "^9.1.0",
    "tiktoken": "^1.0.15",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "@vitest/coverage-v8": "^1.6.0",
    "tsx": "^4.10.0",
    "eslint": "^9.3.0",
    "prettier": "^3.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
